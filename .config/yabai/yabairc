#!/usr/bin/env sh

# Yabai Configuration
# Migrated from Hyprland/AeroSpace config

# ===== Scripting Addition =====
# For advanced features (requires SIP partially disabled)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ===== Spaces =====
# skhd and the bar expect workspaces 1-5; macOS only keeps the Spaces you
# have made, so create any that are missing (needs the scripting addition).
while [ "$(yabai -m query --spaces | jq length)" -lt 5 ]; do
    yabai -m space --create || break
done

# ===== Tiling Settings =====
yabai -m config layout bsp
yabai -m config auto_balance off

# ===== Window Settings =====
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50

# ===== Animations (Hyprland-style) =====
# Smooth window frame animation (move/resize) — requires SIP disabled + Screen Recording
yabai -m config window_animation_duration 0.30
yabai -m config window_animation_easing ease_out_quint

# Opacity (disabled — no transparency)
yabai -m config window_opacity off

# Window shadows for depth
yabai -m config window_shadow float

# ===== Gaps (matching Hyprland: gaps_in=10, gaps_out=20) =====
# yabai -m config bottom_padding 30
yabai -m config left_padding 20
yabai -m config right_padding 20
yabai -m config window_gap 25
yabai -m config external_bar all:62:20

# ===== Mouse Settings =====
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# ===== Window Rules =====
# Float system preferences and other non-tileable apps
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Simulator$" manage=off
yabai -m rule --add app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add app="^Alfred Preferences$" manage=off
yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^Laumei$" manage=off

# Scratchpad (alt+s) and yazi float (alt+shift+e), matched by kitty --title
yabai -m rule --add title="^nvim-scratch$" scratchpad=scratch grid=6:6:1:1:4:4
yabai -m rule --add title="^yazi-float$" manage=off grid=10:10:2:2:6:6

# ===== Simulator =====
# Xcode 27 runs the simulator inside Device Hub: keep it tiled, but in a phone-wide
# column (its side of the split at 21.5%, the phone window's own width) instead of half the screen.
yabai -m signal --add label=devicehub event=window_created app="^Device Hub$" \
    action='yabai -m window $YABAI_WINDOW_ID --ratio abs:0.785'

# ===== No Minimizing =====
# Undo any minimize that gets past skhd's cmd+m block (yellow button,
# title-bar double-click, menu item).
yabai -m signal --add event=window_minimized action='yabai -m window --deminimize $YABAI_WINDOW_ID'

# The quickshell bar (Laumei, `laumei -c mac`) registers its own
# space/window signals when it starts.

# ===== Borders (using JankyBorders) =====
"$HOME/.config/borders/bordersrc" &

echo "yabai configuration loaded..."
