#!/bin/sh
# Launch vesktop off the NVIDIA dGPU, always. Two reasons:
#  - On battery it lets the dGPU runtime-suspend (~5W). hypr/env.lua exports
#    NVIDIA as the global GL/VA-API/GBM default, and vesktop's GPU process
#    otherwise opens the dGPU and keeps it awake.
#  - On 2026-10-06 nvidia-open 615.71.09 oopsed in nv_drm_revoke_modeset_permission
#    when vesktop released its DRM handle, wedging /dev/dri/card0 until reboot
#    (every later open hung in D state). Discord doesn't need the dGPU; never
#    give it one. Both the env overrides and --disable-gpu are needed: either
#    alone still touches the dGPU.
exec env LIBVA_DRIVER_NAME=radeonsi \
    __GLX_VENDOR_LIBRARY_NAME=mesa \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
    VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json \
    GBM_BACKEND= \
    /usr/bin/vesktop --disable-gpu "$@"
