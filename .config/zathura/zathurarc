# Catppuccin Mocha on crust (#11111b) with the green accent, like kitty and the bar.
set default-bg                  "#11111b"
set default-fg                  "#cdd6f4"
set statusbar-bg                "#11111b"
set statusbar-fg                "#cdd6f4"
set inputbar-bg                 "#11111b"
set inputbar-fg                 "#cdd6f4"
set notification-bg             "#11111b"
set notification-fg             "#cdd6f4"
set notification-error-bg       "#11111b"
set notification-error-fg       "#f38ba8"
set notification-warning-bg     "#11111b"
set notification-warning-fg     "#f9e2af"
set highlight-color             "rgba(166,227,161,0.5)"
set highlight-active-color      "#a6e3a1"
set completion-bg               "#313244"
set completion-fg               "#cdd6f4"
set completion-highlight-bg     "#a6e3a1"
set completion-highlight-fg     "#11111b"
set recolor-lightcolor          "#11111b"
set recolor-darkcolor           "#cdd6f4"

set font "CommitMono Nerd Font 10"
set selection-clipboard clipboard
set scroll-step 80
set guioptions ""
# Dark-mode PDFs by default; toggle with ctrl+r
set recolor true
set recolor-keephue true
