configuration {
    show-icons:                     true;
    display-drun: 		            "";
    drun-display-format:            "{icon} {name}";
    disable-history:                false;
    click-to-exit: 		            true;
    location:                       0;
}

@import "font.rasi"
@import "colors.rasi"

window {
    background-color:               @BG;
    text-color:                     @FG;
    border:                         2px;
    border-color:                   @BDR;
    width:                          640px;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}

mainbox {
    background-color:               @BG;
    children:                       [ inputbar, listview ];
    spacing:                        14px;
    padding:                        18px;
}

/* search chip: solid lavender square, dark glyph */
textbox-prompt-colon {
    expand: 			            false;
    str: 			                "";
    background-color:               @BGA;
    text-color:                     @SEL;
    padding:                        10px 15px 10px 15px;
    font:			                "FiraCode Nerd Font Mono 12";
}

entry {
    background-color:               @BGL;
    text-color:                     @FG;
    placeholder-color:              @OFF;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search apps...";
    blink:                          true;
    padding:                        10px 12px;
}

inputbar {
    children: 		                [ textbox-prompt-colon, entry ];
    background-color:               @BGL;
    text-color:                     @FG;
    expand:                         false;
    border:                  	    0px 0px 2px 0px;
    border-color:                   @BDR;
    margin:                         0px;
    padding:                        0px;
    position:                       center;
}

case-indicator {
    background-color:               @BG;
    text-color:                     @FG;
    spacing:                        0;
}

listview {
    background-color:               @BG;
    columns:                        1;
    lines:			                8;
    spacing:                        4px;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
    scrollbar:                      false;
}

element {
    background-color:               @BG;
    text-color:                     @FG;
    orientation:                    horizontal;
    padding:                        8px 10px;
}

element-icon {
    background-color: 	            inherit;
    text-color:       		        inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           28px;
    border:                         0px;
}

element-text {
    background-color: 		        inherit;
    text-color:       		        inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0px 0px 0px 8px;
}

element normal.urgent,
element alternate.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
}

element normal.active,
element alternate.active {
    background-color:               @BGA;
    text-color:                     @FG;
}

/* selected: lavender block, dark text, lavender edge carried by the block itself */
element selected {
    background-color:               @BGA;
    text-color:                     @SEL;
    border:                  	    0px;
}

element selected.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
}

element selected.active {
    background-color:               @BGA;
    color:                          @FG;
}
