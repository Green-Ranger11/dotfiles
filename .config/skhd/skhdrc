# skhd Configuration
# Mirrors ~/.config/hypr/keybinds.lua where macOS has an equivalent.
# alt (option) is the main modifier: it sits where SUPER does on a PC keyboard.
# Note: bound alt combos are swallowed globally, so e.g. option+e/option+i
# accent dead keys no longer type.

# ===== Applications =====
alt - return         : open -na kitty
alt + shift - return : open -na kitty --args "$HOME/.local/bin/herdr"
alt - e              : open ~
alt + shift - e      : open -na kitty --args --title yazi-float -o remember_window_size=no \
                       env YAZI_FLOAT=1 EDITOR=nvim yazi

# Pickers from ~/.config/quickshell/mocha, run by Laumei (`laumei -c mac`)
alt - d    : $HOME/.local/bin/laumei -c mac ipc call launcher toggle
alt - 0x2F : $HOME/.local/bin/laumei -c mac ipc call emoji toggle     # period
alt - 0x2C : $HOME/.local/bin/laumei -c mac ipc call bitwarden toggle # slash
alt + shift - v : $HOME/.local/bin/laumei -c mac ipc call clipboard toggle
alt + shift - b : $HOME/.local/bin/laumei -c mac ipc call bluetooth toggle
alt + shift - n : $HOME/.local/bin/laumei -c mac ipc call network toggle
alt - escape    : $HOME/.local/bin/laumei -c mac ipc call power toggle

# Scratchpad: toggle the nvim-scratch window, launching it if it isn't open
# (see the scratchpad rule in yabairc)
alt - s : yabai -m window --toggle scratch || \
          open -na kitty --args --title nvim-scratch -o remember_window_size=no \
          nvim "$HOME/Documents/scratch.md"

# ===== Window Management =====
alt - q : $HOME/.config/yabai/close-window.sh
alt - v : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2
alt - f : yabai -m window --toggle zoom-fullscreen

# Swallow the macOS minimize shortcuts (yabairc also undoes any other minimize)
cmd - m       : true
cmd + alt - m : true

# ===== Session =====
alt - b : $HOME/.local/bin/laumei -c mac ipc call lock trigger

# ===== Screenshots =====
# Same keys as Linux; PC keyboards send Print Screen as F13 on macOS.
f13              : $HOME/.config/skhd/screenshot.sh full
alt - i          : $HOME/.config/skhd/screenshot.sh full
ctrl - f13       : $HOME/.config/skhd/screenshot.sh edit
ctrl - i         : $HOME/.config/skhd/screenshot.sh edit
shift + ctrl - f13 : $HOME/.config/skhd/screenshot.sh clip
shift + ctrl - i   : $HOME/.config/skhd/screenshot.sh clip

# ===== Focus Movement (vim keys) =====
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ===== Focus Movement (arrow keys) =====
alt - left  : yabai -m window --focus west
alt - down  : yabai -m window --focus south
alt - up    : yabai -m window --focus north
alt - right : yabai -m window --focus east

# ===== Swap Windows =====
# In kitty, cmd stands in for alt (kitty/macos.conf), so herdr/tmux's own
# alt+shift binds are reached with cmd+shift there.
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

alt + shift - left  : yabai -m window --swap west
alt + shift - down  : yabai -m window --swap south
alt + shift - up    : yabai -m window --swap north
alt + shift - right : yabai -m window --swap east

# ===== Switch Spaces =====
alt - 1 : yabai -m space --focus ws1
alt - 2 : yabai -m space --focus ws2
alt - 3 : yabai -m space --focus ws3
alt - 4 : yabai -m space --focus ws4
alt - 5 : yabai -m space --focus ws5
alt - 6 : yabai -m space --focus ws6
alt - 7 : yabai -m space --focus ws7
alt - 8 : yabai -m space --focus ws8
alt - 9 : yabai -m space --focus ws9
alt - 0 : yabai -m space --focus ws10

# ===== Move Window to Space and Follow =====
alt + shift - 1 : yabai -m window --space ws1; yabai -m space --focus ws1
alt + shift - 2 : yabai -m window --space ws2; yabai -m space --focus ws2
alt + shift - 3 : yabai -m window --space ws3; yabai -m space --focus ws3
alt + shift - 4 : yabai -m window --space ws4; yabai -m space --focus ws4
alt + shift - 5 : yabai -m window --space ws5; yabai -m space --focus ws5
alt + shift - 6 : yabai -m window --space ws6; yabai -m space --focus ws6
alt + shift - 7 : yabai -m window --space ws7; yabai -m space --focus ws7
alt + shift - 8 : yabai -m window --space ws8; yabai -m space --focus ws8
alt + shift - 9 : yabai -m window --space ws9; yabai -m space --focus ws9
alt + shift - 0 : yabai -m window --space ws10; yabai -m space --focus ws10

# ===== Move Space to Display =====
alt + ctrl + shift - 0x2F : yabai -m space --display east  # period
alt + ctrl + shift - 0x2B : yabai -m space --display west  # comma

# ===== Layout Controls =====
alt + shift - 0x2F : yabai -m space --layout bsp    # period - BSP layout
alt + shift - 0x2B : yabai -m space --layout stack  # comma  - Stack layout

# ===== Resize =====
alt - r : yabai -m window --resize left:-50:0 2>/dev/null || \
          yabai -m window --resize right:-50:0

alt - 0x18 : yabai -m window --resize right:50:0 2>/dev/null || \
             yabai -m window --resize left:50:0   # = key
alt - 0x1B : yabai -m window --resize left:-50:0 2>/dev/null || \
             yabai -m window --resize right:-50:0 # - key

# ===== Rotate/Balance/Split =====
alt + shift - 0x18 : yabai -m space --balance   # shift+= (alt+e is Finder now)
alt - t            : yabai -m space --rotate 270
alt + shift - s    : yabai -m window --toggle split  # alt+s is the scratchpad now

# ===== Service Commands =====
alt + shift - r : yabai --restart-service; skhd --restart-service
